# Copy to .env at the repository root. Vite reads this directory.
# Values are placeholders. Do not put real secrets here.
VITE_API_BASE_URL=http://localhost:8080

# Backend. Copy this file to .env. Spring Boot loads .env from the repository root
# and from the parent of backend/. A new terminal does not need these exported.
# Keep the password out of the JDBC URL.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/cloudflow?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=cloudflow
SPRING_DATASOURCE_PASSWORD=change-me

# At least 32 bytes. Never commit a real value.
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_EXPIRATION=15m
REQUIRE_VERIFIED_EMAIL=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
WORKER_TOKEN=change-me-worker-token
WORKER_NAME=worker-1
WORKER_BACKEND_URL=http://localhost:8080
WORKER_POLL_INTERVAL=2s
WORKER_HEARTBEAT_TIMEOUT=30s
WORKER_RUNNING_TIMEOUT=2m
WORKER_MAX_ATTEMPTS=3
WORKER_SWEEP_INTERVAL=30s
WORKER_SWEEP_INITIAL_DELAY=30s

# Worker execution. simulator is the default and does not need a daemon.
# docker fails the task when the daemon is down. It does not fall back.
WORKER_EXECUTOR=simulator
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_MEMORY_MB=256
DOCKER_CPU_MILLIS=500

# SMTP. Leave SMTP_HOST empty to boot without sending mail. Placeholders only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
MAIL_VERIFICATION_URL=http://localhost:5173/verify-email
MAIL_RESET_URL=http://localhost:5173/reset-password
MAIL_VERIFICATION_TTL=24h
MAIL_RESET_TTL=30m

# Compose only. Placeholders. The stack creates its own MySQL service and does not
# read SPRING_DATASOURCE_URL, so it does not use the host database.
COMPOSE_MYSQL_PASSWORD=change-me
COMPOSE_MYSQL_ROOT_PASSWORD=change-me-root
